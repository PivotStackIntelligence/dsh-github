{
  "name": "dsh-github",
  "version": "0.3.0",
  "description": "Source Control and GitHub panel for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "compatibility.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh-compatibility": {
    "recommendedHost": "0.1.7-rc.2",
    "supportedHosts": [
      {
        "version": "0.1.7-rc.2",
        "track": "recommended"
      },
      {
        "version": "0.1.2-rc.1",
        "track": "legacy"
      },
      {
        "version": "0.1.0-rc.6",
        "track": "legacy"
      }
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6 || 0.1.2-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.6 || 0.1.2-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6 || 0.1.2-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.0-rc.6 || 0.1.2-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6 || 0.1.2-rc.1 || 0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-loader": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "github",
    "source-control"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/PivotStackIntelligence/dsh-github.git"
  },
  "bugs": {
    "url": "https://github.com/PivotStackIntelligence/dsh-github/issues"
  },
  "homepage": "https://github.com/PivotStackIntelligence/dsh-github",
  "author": {
    "name": "bugmaker2",
    "url": "https://github.com/PivotStackIntelligence"
  }
}